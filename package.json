{
  "name": "dsh-tray-launcher",
  "version": "1.2.0",
  "description": "DeepSeek Harness 的 Windows 桌面托盘启动器：无窗口运行 dsh web，托盘右键切换图标、开机自启、重启 Harness，并内置用量/费用仪表插件（dsh-plugin-usage-meter）的一键安装与更新。",
  "license": "MIT",
  "author": "fancr-code",
  "type": "module",
  "bin": {
    "dsh-tray": "bin/dsh-tray.js",
    "dsh-tray-install": "bin/dsh-tray-install.js"
  },
  "dependencies": {
    "dsh-plugin-usage-meter": "^1.6.1"
  },
  "files": [
    "tray.ps1",
    "launch-hidden.vbs",
    "install.ps1",
    "uninstall.ps1",
    "launch.bat",
    "liangzu-icon.ico",
    "icons/liangzu.ico",
    "icons/whale-girl.ico",
    "icons/deepseek.ico",
    "bin/dsh-tray.js",
    "bin/dsh-tray-install.js",
    "docs/preview-tray.png",
    "docs/liangzu-icon.png",
    "docs/whale-girl.png",
    "docs/deepseek.png",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fancr-code/dsh-tray-launcher.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "windows",
    "system-tray",
    "launcher",
    "powershell"
  ],
  "engines": {
    "node": ">=18"
  }
}
